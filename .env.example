# --- MySQL Database Configuration ---
MYSQL_ROOT_PASSWORD=ToeicDictation@2026!
MYSQL_DATABASE=toeic_dictation
MYSQL_PORT=3306

# --- Backend API Configuration ---
SERVER_PORT=8080
BACKEND_PORT=8080
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/toeic_dictation?useSSL=false&serverTimezone=UTC&characterEncoding=UTF-8&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=ToeicDictation@2026!

# --- Security & JWT Token Configuration ---
# Generate a secure 256-bit+ secret for production
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=604800000

# --- Audio Storage Path (Inside container or local path) ---
