#!/bin/sh
echo "================================================="
echo "  TOEIC Dictation Pre-Commit Quality Gate"
echo "================================================="

echo "1/3: Checking Frontend TypeScript & Production Build..."
cd frontend || exit 1

if [ -n "$COMSPEC" ]; then
  cmd.exe /c "npm run build"
else
  npm run build
fi

if [ $? -ne 0 ]; then
  echo "❌ Error: Frontend build or TypeScript check failed! Commit aborted."
  exit 1
fi

echo "2/3: Running Frontend Vitest Suite..."
if [ -n "$COMSPEC" ]; then
  cmd.exe /c "npm run test"
else
  npm run test
fi

if [ $? -ne 0 ]; then
  echo "❌ Error: Frontend tests failed! Commit aborted."
  exit 1
fi

echo "3/3: Running Linter..."
if [ -n "$COMSPEC" ]; then
  cmd.exe /c "npm run lint"
else
  npm run lint
fi

if [ $? -ne 0 ]; then
  echo "❌ Error: Linter checks failed! Commit aborted."
  exit 1
fi

echo "================================================="
echo "  All Quality Checks Passed! Proceeding Commit."
echo "================================================="
exit 0
